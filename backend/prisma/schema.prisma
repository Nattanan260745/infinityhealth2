generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int      @id @default(autoincrement()) @map("user_id")
  email       String   @unique
  password    String
  firstName   String   @map("first_name")
  lastName    String   @map("last_name")
  role        Role     @default(user)
  profileImg  String?  @map("profile_img")
  bio         String?
  pushToken   String?  @map("push_token")
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  userStats      UserStats?
  userMissions   UserMission[]
  healthTracking HealthTracking[]
  dailyGoals     DailyGoal[]
  routines       Routine[]
  notifications  Notification[]

  pointHistory     PointHistory[]

  @@map("users")
}

model DailyGoal {
  id        Int      @id @default(autoincrement()) @map("goal_id")
  userId    Int      @map("user_id")
  title     String
  goalDate  DateTime @default(now()) @map("goal_date") @db.Date
  completed Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("daily_goals")
}

model Routine {
  id            Int      @id @default(autoincrement()) @map("routine_id")
  userId        Int      @map("user_id")
  title         String
  scheduledTime String   @map("scheduled_time")
  scheduledDate DateTime @default(now()) @map("scheduled_date") @db.Date
  completed     Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("routines")
}

model UserStats {
  id               Int       @id @default(autoincrement()) @map("stat_id")
  userId           Int       @unique @map("user_id")
  level            Int       @default(1)
  currentExp       Int       @default(0) @map("current_exp")
  totalPoints      Int       @default(0) @map("total_points")
  currentStreak    Int       @default(0) @map("current_streak")
  lastActivityDate DateTime? @map("last_activity_date") @db.Date

  user User @relation(fields: [userId], references: [id])

  @@map("user_stats")
}

model Level {
  id          Int     @id @default(autoincrement()) @map("level_id")
  levelNumber Int     @map("level_number")
  levelName   String  @map("level_name")
  titleTh     String? @map("title_th")
  color       String?
  hexCode     String? @map("hex_code")
  minExp      Int     @map("min_exp")
  maxExp      Int     @map("max_exp")

  @@map("levels")
}

model Mission {
  id            Int         @id @default(autoincrement()) @map("mission_id")
  missionName   String      @map("mission_name")
  missionType   MissionType @map("mission_type")
  requiredLevel Int         @map("required_level")
  rewardExp     Int         @map("reward_exp")
  rewardPoints  Int         @map("reward_points")
  targetValue   Int         @map("target_value")
  targetUnit    String      @map("target_unit")
  durationDays  Int?        @map("duration_days")
  description   String?
  startTime     String?     @map("start_time")
  endTime       String?     @map("end_time")
  isActive      Boolean     @default(true) @map("is_active")
  presets       Json?       @map("presets")

  userMissions UserMission[]
  pointHistory PointHistory[]

  @@map("missions")
}

model ExerciseCategory {
  id           Int      @id @default(autoincrement()) @map("category_id")
  categoryName String   @map("category_name")
  iconUrl      String?  @map("icon_url")
  createdAt    DateTime @default(now()) @map("created_at")

  exercises Exercise[]

  @@map("exercise_categories")
}

model Exercise {
  id          Int      @id @default(autoincrement()) @map("video_id")
  categoryId  Int      @map("category_id")
  title       String   @map("video_title")
  videoUrl    String?  @map("video_url")
  thumbnail   String?  @map("video_thumbnail")
  difficulty  String   @map("difficulty_level")
  bodyPart    String?  @map("body_part")
  duration    Int?     @map("duration_minutes")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  category ExerciseCategory @relation(fields: [categoryId], references: [id])

  @@map("exercise_videos")
}

model UserMission {
  id              Int       @id @default(autoincrement()) @map("user_mission_id")
  userId          Int       @map("user_id")
  missionId       Int       @map("mission_id")
  startDate       DateTime? @map("start_date") @db.Date
  endDate         DateTime? @map("end_date") @db.Date
  currentProgress Int       @default(0) @map("current_progress")
  status          Boolean   @default(false)
  completedAt     DateTime? @map("completed_at")
  isClaimed       Boolean   @default(false) @map("is_claimed")
  claimedAt       DateTime? @map("claimed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@map("user_missions")
}

model HealthTracking {
  id           Int      @id @default(autoincrement()) @map("tracking_id")
  userId       Int      @map("user_id")
  trackingDate DateTime @default(now()) @map("tracking_date") @db.Date
  weight       Float?
  height       Float?
  water        Int?
  sleepHours   Float?   @map("sleep_hours")
  stepsCount   Int?     @map("steps_count")

  user User @relation(fields: [userId], references: [id])

  @@map("health_tracking")
}

enum Role {
  user
  admin
}

enum MissionType {
  DAILY
  CHALLENGE
}

model Notification {
  id          Int              @id @default(autoincrement()) @map("notification_id")
  userId      Int              @map("user_id")
  type        NotificationType
  title       String
  message     String
  isRead      Boolean          @default(false) @map("is_read")
  isSent      Boolean          @default(false) @map("is_sent")
  notiAt      DateTime         @default(now()) @map("noti_at")
  referenceId Int?             @map("reference_id")
  createdAt   DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

enum NotificationType {
  SYSTEM
  MISSION_COMPLETED
  LEVEL_UP
  ROUTINE_REMINDER
}

model PointHistory {
  id           Int       @id @default(autoincrement()) @map("history_id")
  userId       Int       @map("user_id")
  missionId    Int?      @map("mission_id")
  pointsEarned Int       @map("points_earned")
  pointType    PointType @map("point_type")
  earnedAt     DateTime  @default(now()) @map("earned_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission Mission? @relation(fields: [missionId], references: [id])

  @@map("point_history")
}

enum PointType {
  MISSION
  OTHER
}
